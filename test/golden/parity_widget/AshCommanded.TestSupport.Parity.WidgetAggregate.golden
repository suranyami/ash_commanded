# gsd-budget: clause_max=72 module_lines=208
# gsd-staged-until-phase: 4
defmodule AshCommanded.TestSupport.Parity.WidgetAggregate do
  @moduledoc "Aggregate for Widget resource handling commands and events"
  alias AshCommanded.Error
  alias AshCommanded.Snapshot
  alias AshCommanded.SnapshotStore
  defstruct id: nil, label: nil, version: 0

  (
    @doc "Returns the snapshot version for this aggregate.\n\n## Returns\n\nThe snapshot version number\n\n## Examples\n\n    iex> MyApp.UserAggregate.snapshot_version()\n    1\n"
    @spec snapshot_version() :: integer()
    def snapshot_version do
      1
    end

    @doc "Returns the snapshot threshold for this aggregate.\nThis is the number of events to process before taking a snapshot.\n\n## Returns\n\nThe snapshot threshold\n\n## Examples\n\n    iex> MyApp.UserAggregate.snapshot_threshold()\n    100\n"
    @spec snapshot_threshold() :: integer()
    def snapshot_threshold do
      100
    end

    @doc "Checks if a snapshot should be taken based on the aggregate's version.\n\n## Parameters\n\n- `state` - The current state of the aggregate\n\n## Returns\n\n`true` if a snapshot should be taken, `false` otherwise\n\n## Examples\n\n    iex> state = %MyApp.UserAggregate{version: 105}\n    iex> MyApp.UserAggregate.should_snapshot?(state)\n    true\n    \n    iex> state = %MyApp.UserAggregate{version: 42}\n    iex> MyApp.UserAggregate.should_snapshot?(state)\n    false\n"
    @spec should_snapshot?(%__MODULE__{}) :: boolean()
    def should_snapshot?(%__MODULE__{} = state) do
      false && state.version > 0 && rem(state.version, snapshot_threshold()) == 0
    end
  )

  (
    @doc "No-op when snapshotting is disabled; returns state unchanged.\nDefined so apply/2 can always call snapshot_state_if_needed/1.\n"
    @spec snapshot_state_if_needed(%__MODULE__{}) :: %__MODULE__{}
    def snapshot_state_if_needed(%__MODULE__{} = state) do
      state
    end
  )

  (
    @doc "Handles the #{:create_widget} command and produces events.

## Parameters

- `aggregate` - The current state of the aggregate
- `command` - The command to execute

## Returns

- `{:ok, event}` - When command is successfully executed
- `{:error, error}` - When command execution fails with standardized error
"
    def execute(
          %__MODULE__{} = aggregate,
          %AshCommanded.TestSupport.Parity.Commands.CreateWidget{} = command
        ) do
      resource_module = AshCommanded.TestSupport.Parity.Widget

      context = %{
        aggregate: aggregate,
        identity_field: :id,
        action_name: :create,
        action_type: nil,
        param_mapping: nil,
        metadata: %{},
        command: command,
        resource: resource_module
      }

      try do
        AshCommanded.Middleware.CommandMiddlewareProcessor.apply_middleware(
          command,
          resource_module,
          context,
          fn cmd, ctx ->
            process_command(
              ctx.aggregate,
              cmd,
              resource_module,
              ctx.action_name,
              ctx.identity_field,
              AshCommanded.TestSupport.Parity.Events.WidgetCreated,
              [] ++ [] ++ [transforms: [], validations: []] ++ [] ++ [] ++ [] ++ []
            )
          end
        )
      rescue
        e in _ ->
          {:error,
           Error.aggregate_error("Error executing command: #{Exception.message(e)}",
             context: %{
               command: :create_widget,
               command_module: AshCommanded.TestSupport.Parity.Commands.CreateWidget,
               error: inspect(e)
             }
           )}
      end
    end

    defp process_command(
           aggregate,
           command,
           resource_module,
           action_name,
           identity_field,
           event_module,
           opts
         ) do
      command_id = Map.get(command, identity_field)
      aggregate_id = Map.get(aggregate, identity_field)
      middleware_context = opts |> Keyword.get(:context, %{})
      middleware_context = Map.put(middleware_context, :aggregate, aggregate)
      middleware_context = Map.put(middleware_context, :command, command)
      action_opts = opts ++ [identity_field: identity_field, context: middleware_context]

      cond do
        is_nil(aggregate_id) ->
          case AshCommanded.CommandActionMapper.map_to_action(
                 command,
                 resource_module,
                 action_name,
                 action_opts
               ) do
            {:ok, result} ->
              event_data = Map.from_struct(command)

              event_data =
                if is_map(result) and not is_struct(result) do
                  Map.merge(event_data, result)
                else
                  event_data
                end

              {:ok, struct(event_module, event_data)}

            {:error, reason} ->
              {:error, reason}
          end

        aggregate_id == command_id ->
          case AshCommanded.CommandActionMapper.map_to_action(
                 command,
                 resource_module,
                 action_name,
                 action_opts
               ) do
            {:ok, result} ->
              event_data = Map.from_struct(command)

              event_data =
                if is_map(result) and not is_struct(result) do
                  Map.merge(event_data, result)
                else
                  event_data
                end

              {:ok, struct(event_module, event_data)}

            {:error, reason} ->
              {:error, reason}
          end

        true ->
          {:error,
           Error.aggregate_error("Invalid identity",
             field: identity_field,
             value: command_id,
             context: %{aggregate_id: aggregate_id, command_id: command_id}
           )}
      end
    end
  )

  (
    @doc "Applies the #{:widget_created} event to the aggregate state.

## Parameters

- `state` - The current state of the aggregate
- `event` - The event to apply

## Returns

The updated aggregate state
"
    def apply(
          %__MODULE__{} = state,
          %AshCommanded.TestSupport.Parity.Events.WidgetCreated{} = event
        ) do
      try do
        changes =
          [:id, :label]
          |> Enum.reduce(%{}, fn field, acc ->
            if Map.has_key?(event, field) do
              Map.put(acc, field, Map.get(event, field))
            else
              acc
            end
          end)

        updated_state = Map.merge(state, changes)
        updated_state = Map.update(updated_state, :version, 1, &(&1 + 1))
        snapshot_state_if_needed(updated_state)
      rescue
        e in _ ->
          require Logger
          Logger.error("Error applying event #{:widget_created}: #{Exception.message(e)}")
          state
      end
    end
  )
end
